{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightfire.block.image@1",
  "title": "Nightfire image block payload",
  "type": "object",
  "required": ["media_id"],
  "properties": {
    "media_id": { "type": "string", "minLength": 1 },
    "alt": { "type": "string" },
    "title": { "type": "string" },
    "caption": { "type": "string" },
    "sizing": { "enum": ["small", "medium", "large", "full"] }
  },
  "additionalProperties": false
}
