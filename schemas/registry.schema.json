{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightfire.registry@1",
  "title": "Nightfire block registry",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockDescriptor" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "blockDescriptor": {
      "type": "object",
      "required": ["type", "label", "category", "current", "supported"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "current": { "type": "string", "minLength": 1 },
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
